# Authentification SSO (OpenID Connect) — copiez ce fichier en .streamlit/secrets.toml.
# Nécessite le paquet Authlib (pip install Authlib). Sans ce fichier, l'application est ouverte.
# Exemple avec Microsoft Entra ID ; tout fournisseur OIDC convient (Okta, Keycloak, Google…).

[auth]
redirect_uri = "https://text2sql.votre-banque.example/oauth2callback"
cookie_secret = "remplacez-par-une-longue-chaine-aleatoire"
client_id = "identifiant-application"
client_secret = "secret-application"
server_metadata_url = "https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration"
